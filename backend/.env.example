# Copy to .env (never commit .env). Variable NAMES and local-dev placeholders only.
DATABASE_URL=postgres://tenderlens:change_me@localhost:5432/tenderlens
# Used only by the test suite. The database name MUST end with "_test".
TEST_DATABASE_URL=postgres://tenderlens:change_me@localhost:5432/tenderlens_test
PORT=4000
CORS_ORIGIN=http://localhost:5173
# IANA timezone used for "today" in dashboard calculations and monthly buckets.
APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development
