{
  "name": "tenderlens-backend",
  "version": "0.1.0",
  "private": true,
  "description": "TenderLens main API (Feature 1: project foundation)",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/seed-demo.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "express": "^4.22.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pdfjs-dist": "^6.4.299",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
