# Optional. Leave empty in development: Vite proxies /api to the backend (see VITE_DEV_API_TARGET).
# Set to the API origin (e.g. https://api.example.com) when the API is served from a different origin.
VITE_API_BASE_URL=
# Dev proxy target for /api (default http://localhost:4000)
VITE_DEV_API_TARGET=http://localhost:4000
